{
  "name": "fugenplan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Verlegeplaner für Fliesen und Dielen mit PDF-Grundriss, Maßstab, Zuschnitten und lokaler Speicherung.",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:all": "playwright test -c playwright.all.config.ts",
    "test:e2e:edge": "playwright test -c playwright.edge.config.ts",
    "check": "npm test && npm run build",
    "start": "vite --host 127.0.0.1 --open",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "prestart": "node scripts/copy-pdf-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "test:hosting": "playwright test -c playwright.hosting.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "clipper-lib": "^6.4.2",
    "pdfjs-dist": "^6.5.438",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/clipper-lib": "^6.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "license": "UNLICENSED"
}
